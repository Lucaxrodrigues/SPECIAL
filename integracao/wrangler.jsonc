{
  "name": "alfa-max-variantes",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "SITE_ORIGIN": "https://dropixeditoralivros.com",
    "SITE_PATH_PREFIX": "",
    "ALFA_MAX_PRICE_ID": "",
    "FALLBACK_CURRENCY": "usd",
    "ALLOW_LIVE_PAYMENTS": "false",
    "AUTOMATIC_TAX_ENABLED": "false",
    "ALLOW_PROMOTION_CODES": "false"
  },
  "ratelimits": [{
    "name": "CHECKOUT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 300, "period": 60 }
  }]
}
